flowchart LR
    subgraph BUYER[Satın Alma Ekibi]
        B1[Firma daveti oluşturur]
        B2[Başvuruyu ve AI bulgularını inceler]
        B3{Eksik veya tutarsız bilgi var mı?}
        B4[Eksik bilgi talebi gönderir]
        B5{Başvuru kararı}
        B6[Başvuruyu onaylar]
        B7[Başvuruyu reddeder]
    end

    subgraph SUPPLIER[Tedarikçi]
        S1[Davet bağlantısını açar]
        S2[Hesabını aktive eder]
        S3[Şirket bilgilerini ve belgeleri tamamlar]
        S4[Başvuruyu gönderir]
        S5[Eksik veya tutarsız bilgileri düzeltir]
    end

    subgraph SYSTEM[Sistem]
        Y1[Invitation kaydı oluşur]
        Y2[Onboarding Application açılır]
        Y3[Başvuru ve belgeler kaydedilir]
        Y4[Supplier Organization oluşturulur]
        Y5[Tam portal erişimi açılır]
    end

    subgraph AI[Yapay Zekâ Desteği]
        A1[Belgelerden başvuru bilgilerini çıkarır]
        A2[Form ve belge tutarsızlıklarını işaretler]
        A3[Eksik bilgi uyarıları oluşturur]
        A4[Mükerrer tedarikçi adaylarını tespit eder]
        A5[AI bulgularını Buyer incelemesine sunar]
    end

    B1 --> Y1 --> S1 --> S2 --> Y2 --> S3 --> S4 --> Y3
    Y3 --> A1 --> A2 --> A3 --> A4 --> A5 --> B2 --> B3

    B3 -->|Evet| B4 --> S5 --> S4
    B3 -->|Hayır| B5
    B5 -->|Onay| B6 --> Y4 --> Y5
    B5 -->|Ret| B7

    Y2 -. "Onaylanana kadar operasyonel alanlar kilitlidir" .-> Y5
    A5 -. "AI yalnız öneri ve uyarı üretir; nihai karar Buyer'dadır" .-> B5

    classDef buyer fill:#DBEAFE,stroke:#2563EB,color:#172554
    classDef supplier fill:#DCFCE7,stroke:#16A34A,color:#14532D
    classDef system fill:#F3E8FF,stroke:#9333EA,color:#581C87
    classDef ai fill:#FCE7F3,stroke:#DB2777,color:#831843
    classDef decision fill:#FEF3C7,stroke:#D97706,color:#78350F

    class B1,B2,B4,B6,B7 buyer
    class S1,S2,S3,S4,S5 supplier
    class Y1,Y2,Y3,Y4,Y5 system
    class A1,A2,A3,A4,A5 ai
    class B3,B5 decision
